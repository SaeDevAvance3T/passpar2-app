<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/black"
    tools:context="Accueil_fragment_details">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingVertical="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="@string/course_details"
                android:textColor="@color/white"
                android:textSize="20dp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/itinerary_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="50dp"
                android:paddingBottom="10dp"
                android:text="@string/course_name"
                android:textColor="@color/white"
                android:textSize="18dp"/>
        </LinearLayout>
        <TextView
            android:id="@+id/text_choice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="50dp"
            android:paddingBottom="10dp"
            android:text="@string/itinerary_entreprises"
            android:textColor="@color/white"
            android:textSize="18dp" />
        <ListView
            android:id="@+id/enterpriselist"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:textColor="@color/white"/>
        <TextView
            android:id="@+id/displayed_enterprises"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/pause_course_button"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="20dp"
            android:background="@color/green"
            android:text="@string/pause_course_button" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/stop_course_button"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="20dp"
            android:background="@color/rouge"
            android:text="@string/stop_course_button" />
    </LinearLayout>

</RelativeLayout>
